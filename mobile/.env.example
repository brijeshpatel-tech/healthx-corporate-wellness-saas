# HealthX Employee app (Expo) — environment variables
#
# Copy the keys you need into .env.development (npm start), .env.staging (npm run start:staging)
# or .env.production (production builds / npm run export:web). All values may stay blank:
# with no API URL the app runs fully on built-in SAMPLE DATA.
#
# EXPO_PUBLIC_* values are compiled into the app bundle — never put secrets here.
# After changing a value, restart the dev server (npx expo start --clear).

# ─── App ────────────────────────────────────────────────────────────────
# development | staging | production. Controls the app name / bundle id suffix
# (.dev / .staging / none). Blank = taken from the script / EAS profile (development by default).
EXPO_PUBLIC_APP_ENV=
# Display name, default "HealthX" (" Dev" / " Staging" is appended outside production).
EXPO_PUBLIC_APP_NAME=

# ─── Backend API ────────────────────────────────────────────────────────
# Base URL without /api/v1, e.g. https://api.healthx.life  (Android emulator → http://10.0.2.2:4000).
# Blank = sample-data mode.
EXPO_PUBLIC_API_BASE_URL=
# API version segment, default v1  →  {base}/api/v1/...
EXPO_PUBLIC_API_VERSION=
# "true" forces sample data even when an API URL is set.
EXPO_PUBLIC_USE_MOCK_API=
# Request timeout in milliseconds, default 20000.
EXPO_PUBLIC_API_TIMEOUT_MS=
# Realtime (leaderboards / live progress) WebSocket URL, e.g. wss://api.healthx.life/ws
EXPO_PUBLIC_WS_URL=

# ─── Sign in with Google (OAuth client ids from Google Cloud Console) ───
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─── Sign in with Microsoft (Entra ID app registration) ─────────────────
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
# Tenant id, or "common" (default) for any work account.
EXPO_PUBLIC_MICROSOFT_TENANT_ID=

# ─── Monitoring & analytics ─────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
# e.g. https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=

# ─── Support ────────────────────────────────────────────────────────────
# Shown on help / error screens, default support@healthx.life
EXPO_PUBLIC_SUPPORT_EMAIL=
