# ════════════════════════════════════════════════════════════════════
#  HealthX Business — Web (admin-portal, business-portal, employee-app)
#  Copy this file to .env.development / .env.staging / .env.production
#  and fill in the values. Only NEXT_PUBLIC_* values reach the browser,
#  so never put secrets (private keys, DB passwords) in this file.
# ════════════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────────
# development | staging | production
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_APP_NAME=
# Public URL of this web app, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=

# ─── Backend API ────────────────────────────────────────────────────
# e.g. http://localhost:4000 — leave blank to run on built-in sample data
NEXT_PUBLIC_API_BASE_URL=
# API version prefix (default: v1 → /api/v1/...)
NEXT_PUBLIC_API_VERSION=
# true = always use sample data, false = call the real backend
NEXT_PUBLIC_USE_MOCK_API=
# Real-time updates (leaderboards), e.g. wss://api.example.com
NEXT_PUBLIC_WS_URL=
# Request timeout in milliseconds (default: 20000)
NEXT_PUBLIC_API_TIMEOUT_MS=

# ─── Sign-in providers ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# ─── Firebase (web push notifications for the employee web app) ────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Files / CDN (images, logos, content media) ────────────────────
NEXT_PUBLIC_ASSETS_CDN_URL=

# ─── Monitoring & product analytics ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── Support ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
